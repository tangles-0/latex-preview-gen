DATABASE_URL=postgresql://user:password@localhost:5432/latex-preview-gen
LATEX_OUTGOING_API_SECRET_KEY=your-secret-key
LATEX_INCOMING_API_SECRET_KEY=your-secret-key
LATEX_API_BASE_URL=https://latex.example.com
DOWNLOAD_PATH=./data/downloads/
THUMBNAIL_PATH=./data/thumbnails/
LATEX_PREVIEW_TMP_DIR=./data/tmp/
PREVIEW_CONCURRENCY=2
# Enables authenticated thumbnail jobs to use localSourcePath beneath this root.
# Leave unset when the worker cannot mount the node's media library.
# NODE_LIBRARY_PATH=/mnt/latex-library
IMAGE_GENERATION_API_URL=http://ubuntu-server:7861
IMAGE_GENERATION_PATH=./data/image-generations/
YOUTUBE_DOWNLOAD_PATH=./data/youtube/downloads/
YOUTUBE_THUMBNAIL_PATH=./data/youtube/thumbnails/
YT_DLP_BINARY_PATH=./binaries
YT_DLP_BINARY=yt-dlp-wrapper.sh
YT_DLP_REAL_BINARY=./binaries/yt-dlp_linux
YT_DLP_COOKIES_PATH=./binaries/cookies.txt
YT_DLP_JS_RUNTIME=deno
#ENABLE_DIAG_PAGE=true # do not apply in production